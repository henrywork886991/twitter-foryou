# ── AI API（必填）────────────────────────────────────────────────────────────
# 支援任何 OpenAI-compatible 服務（DeepSeek / Groq / OpenAI 等）
# DeepSeek 申請：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# ── Telegram 推送（選填）──────────────────────────────────────────────────────
# 報告圖片自動發送到 Telegram 頻道
# Bot Token 申請：https://t.me/BotFather
TG_BOT_TOKEN=
TG_CHAT_ID=

# ── 進階調整（選填）──────────────────────────────────────────────────────────
# 每次滾動次數（預設 80，約抓 25-35 篇推文，耗時約 60 秒）
# FORYOU_SCROLLS=80

# 累積幾篇觸發批次報告（預設 50）
# FORYOU_BATCH_SIZE=50

# 自訂 SQLite 路徑（預設 data/foryou.db）
# FORYOU_DB=
